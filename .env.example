# SQLite by default. For Postgres: postgresql+psycopg://user:pass@localhost:5432/swarm
# DATABASE_URL=sqlite:///backend/swarm.db

# local = SQLite stand-in for Meko (demo only); real = Meko SDK (fill in backend/app/meko_backends.py:RealMeko)
MEKO_BACKEND=local
MEKO_API_KEY=

# Any OpenAI-compatible endpoint. Unreachable → rule-based fallbacks keep the demo running.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama

CORS_ORIGINS=http://localhost:3000
