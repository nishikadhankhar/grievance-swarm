# SQLite by default. For Postgres: postgresql+psycopg://user:pass@localhost:5432/swarm
# DATABASE_URL=sqlite:///backend/swarm.db

# local = SQLite stand-in for Meko (demo only); real = Meko's MCP server
# Key: Meko portal > Settings > API Keys (starts with mko_tkn_). Check with: cd backend && .venv/bin/python -m app.meko_check
MEKO_BACKEND=local
MEKO_API_KEY=
# MEKO_DATAPACK_PREFIX=gs-   # demo datapacks become gs-desk, gs-dept-wifi, ... in Meko (6 of the Free plan's 10)

# Any OpenAI-compatible endpoint. Unreachable → rule-based fallbacks keep the demo running.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama

# Staff sign-up needs this code (students don't). Change it anywhere other people can reach.
STAFF_SIGNUP_CODE=campus-staff
# Seeded demo accounts (<id>@demo.campus) and whether the sign-in page lists them.
DEMO_PASSWORD=demo1234
DEMO_ACCOUNTS=true

CORS_ORIGINS=http://localhost:3000
